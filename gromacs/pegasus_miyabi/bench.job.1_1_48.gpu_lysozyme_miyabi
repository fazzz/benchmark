#!/bin/sh -l

#PBS -V
#PBS -j oe
#PBS -q regular-g
#PBS -l select=1:mpiprocs=1:ompthreads=48
#PBS -l walltime=00:10:00
#PBS -W group_list=xg25i007
#PBS -N gx24_t4l

module purge
module load gcc/11.4.1
module load ompi-cuda/4.1.6-12.6
module load gromacs-gpu/2024.4

cd ${PBS_O_WORKDIR}

gmx_mpi grompp -f input/production.mdp -o 1_1_48.gpu/production.tpr -c input/final_density_stabilization.gro -p input/topol.top

cd 1_1_48.gpu

mpirun -hostfile ${PBS_NODEFILE} -np 1 -npernode 1 gmx_mpi mdrun -noconfout -maxh 0.05 -nb gpu -bonded gpu -pme gpu -deffnm production

rm production.edr
rm production.tpr
rm production.xtc
rm production.trr
rm mdout.mdp
rm \#*

